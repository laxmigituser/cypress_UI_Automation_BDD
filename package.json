{
  "name": "cypress_automation_bdd",
  "version": "1.0.0",
  "description": "framework with BDD support",
  "main": "index.js",
  "scripts": {
    "testregression": "npx cypress run --env tags=\"@regression\" --headed --browser chrome & node custom-report-config.js",
    "regressionrunner": "node regression_runner_with_report.js",
    "alltestrunner": "node alltest_runner_with_report.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cypress/browserify-preprocessor": "3.0.2",
    "cypress": "^14.5.2"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.2.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "cypress-xpath": "^2.0.1",
    "dayjs": "^1.11.13",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.3",
    "mysql": "^2.18.1",
    "mysql2": "^3.15.0"
  },
  "cypress-cucumber-preprocessor": {
    "json": {
      "enabled": true,
      "output": "cypress/test_reports/test_result.json"
    },
    "html": {
      "enabled": true,
      "output": "cypress/test_reports/test_result.html"
    },
    "e2e": {
      "stepDefinitions": [
        "cypress/e2e/ui_tests_BDD/common_stepdefinitions/*.{js,ts}",
        "cypress/e2e/ui_tests_BDD/[filepath]/*.{js,ts}"
      ]
    }
  }
}
